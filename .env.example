# Candidate email flags. Each on/off flag stays off unless the value is
# 1, true, yes, or on. Leave them empty. Do not put real addresses here.

# Automatic Batería TS email only. Off records "batería pendiente de envío".
BATTERY_AUTO_SEND_ENABLED=

# Gmail draft on a move to assessment_invitado, and the welcome draft on contratado.
STAGE_DRAFTS_ENABLED=

# PATCH /api/applications/[id] mail for interview, offer, and hired.
APPLICATION_STATUS_EMAILS_ENABLED=

# Rejection mail: stage draft, reject-with-reason, resend, and that PATCH.
REJECTION_EMAILS_ENABLED=

# Interview-invite allowlist. Empty refuses the send.
INTERVIEW_TEST_RECIPIENTS=

# Only lift that mails the real candidate and the interviewer. Leave empty.
INTERVIEW_INVITES_UNRESTRICTED=

# Does not gate the send. Leave empty.
INTERVIEW_INVITES_ENABLED=

# HR Admin. Leave secrets empty. Do not reuse one value for another name.
# Cloud Run names are in infra/gcp/*-careers*.service.yaml.
HR_ADMIN_SESSION_SECRET=
ADMIN_SCRIPTS_SECRET=
ADMIN_SECRET=
GOOGLE_ADMIN_OAUTH_CLIENT_ID=
GOOGLE_ADMIN_OAUTH_CLIENT_SECRET=
HR_ADMIN_ALLOWED_EMAILS=
GOOGLE_MAILBOX_ALLOWED_EMAILS=
IAP_AUDIENCE=
HR_ADMIN_PASSWORD_LOGIN_ENABLED=0
PORTAL_TOKEN_SECRET=
PORTAL_TOKEN_LEGACY_UNTIL=
